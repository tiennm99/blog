{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "ask",
      "node scripts/newsletter *": "allow",
      "git status*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git mv*": "allow",
      "hugo*": "allow",
      "cat *": "allow",
      "ls *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "mkdir *": "allow",
      "find *": "allow",
      "find * -delete*": "ask",
      "find * -exec*": "ask",
      "grep *": "allow",
      "head *": "allow",
      "sort*": "allow",
      "awk *": "allow",
      "wc *": "allow",
      "curl *": "allow",
      "npx -y agent-browser *": "allow"
    }
  }
}
