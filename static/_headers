# Cloudflare Pages response headers. These paths hold only content-hashed
# files (Hugo fingerprinted bundles and processed images, Pagefind shards),
# so a changed file always gets a new URL.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable
